PAPERALIGN_ENVIRONMENT=development
PAPERALIGN_HOST=127.0.0.1
PAPERALIGN_PORT=8000
PAPERALIGN_DATA_DIR=.paperalign
PAPERALIGN_LOG_LEVEL=INFO
PAPERALIGN_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Optional. Preparing a review plan never calls a model. run-ai-review requires
# an explicit --confirm-send-cloud flag and never logs this key.
PAPERALIGN_AI_MODE=off
PAPERALIGN_AI_PROVIDER=deepseek_responses
PAPERALIGN_AI_BASE_URL=https://api.deepseek.com
PAPERALIGN_AI_API_KEY=
PAPERALIGN_AI_MODEL=
PAPERALIGN_AI_TIMEOUT_SECONDS=30
PAPERALIGN_AI_MAX_OUTPUT_TOKENS=500
PAPERALIGN_AI_MAX_RETRIES=1
# Optional, user-supplied rates used only for local cost estimates.
PAPERALIGN_AI_INPUT_COST_PER_MILLION=
PAPERALIGN_AI_OUTPUT_COST_PER_MILLION=
