PAPERALIGN_ENVIRONMENT=development
PAPERALIGN_HOST=127.0.0.1
PAPERALIGN_PORT=8000
PAPERALIGN_DATA_DIR=.paperalign
PAPERALIGN_LOG_LEVEL=INFO
PAPERALIGN_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Optional. M0 does not call any model provider.
PAPERALIGN_AI_MODE=off
PAPERALIGN_AI_BASE_URL=
PAPERALIGN_AI_API_KEY=
PAPERALIGN_AI_MODEL=
