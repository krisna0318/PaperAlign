{
  "$defs": {
    "HybridDecision": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "auto_accept",
            "manual_review"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "selected_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Confidence"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "text_sha256",
        "outcome",
        "reasons"
      ],
      "title": "HybridDecision",
      "type": "object"
    },
    "RuleScope": {
      "enum": [
        "document",
        "section",
        "cover_title",
        "cover_document_type",
        "cover_metadata",
        "declaration",
        "abstract_zh_heading",
        "abstract_zh_body",
        "abstract_en_title",
        "abstract_en_author",
        "abstract_en_affiliation",
        "abstract_en_body",
        "keywords_zh",
        "keywords_en",
        "toc_heading",
        "toc_entry",
        "heading_1",
        "heading_2",
        "heading_3",
        "heading_4",
        "body",
        "abbreviation_table",
        "table",
        "table_text",
        "table_caption",
        "table_note",
        "figure",
        "figure_caption",
        "figure_note",
        "equation",
        "footnote",
        "reference_heading",
        "reference_entry",
        "appendix_heading",
        "appendix_body",
        "acknowledgement_heading",
        "acknowledgement_body"
      ],
      "title": "RuleScope",
      "type": "string"
    },
    "SemanticRole": {
      "enum": [
        "cover",
        "declaration",
        "abstract_zh",
        "abstract_en",
        "keywords_zh",
        "keywords_en",
        "table_of_contents",
        "heading_1",
        "heading_2",
        "heading_3",
        "heading_4",
        "body",
        "list_item",
        "table",
        "table_text",
        "abbreviation_table",
        "abbreviation_heading",
        "figure",
        "equation",
        "figure_caption",
        "table_caption",
        "reference_heading",
        "reference_entry",
        "appendix_heading",
        "appendix_body",
        "acknowledgement_heading",
        "acknowledgement_body",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "policy_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Policy Version",
      "type": "string"
    },
    "policy_status": {
      "const": "provisional_not_accuracy_validated",
      "default": "provisional_not_accuracy_validated",
      "title": "Policy Status",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "content_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Fingerprint",
      "type": "string"
    },
    "plan_mode": {
      "enum": [
        "prompt_only",
        "hybrid"
      ],
      "title": "Plan Mode",
      "type": "string"
    },
    "model_provider": {
      "enum": [
        "openai_responses",
        "deepseek_responses"
      ],
      "title": "Model Provider",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "confidence_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence Threshold",
      "type": "number"
    },
    "formatting_allowed": {
      "const": false,
      "default": false,
      "title": "Formatting Allowed",
      "type": "boolean"
    },
    "target_count": {
      "minimum": 0,
      "title": "Target Count",
      "type": "integer"
    },
    "auto_accept_count": {
      "minimum": 0,
      "title": "Auto Accept Count",
      "type": "integer"
    },
    "manual_review_count": {
      "minimum": 0,
      "title": "Manual Review Count",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/HybridDecision"
      },
      "title": "Decisions",
      "type": "array"
    }
  },
  "required": [
    "input_sha256",
    "content_fingerprint",
    "plan_mode",
    "model_provider",
    "model",
    "confidence_threshold",
    "target_count",
    "auto_accept_count",
    "manual_review_count",
    "decisions"
  ],
  "title": "HybridReview",
  "type": "object",
  "$id": "https://paperalign.local/schemas/hybrid_review.schema.json"
}
