{
  "$defs": {
    "IssueSeverity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "IssueStatus": {
      "enum": [
        "open",
        "confirmed",
        "dismissed",
        "fixed",
        "not_evaluated"
      ],
      "title": "IssueStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A traceable mismatch between one block and one formatting rule.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "block_id": {
      "minLength": 1,
      "title": "Block Id",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/IssueSeverity"
    },
    "expected": {
      "title": "Expected"
    },
    "actual": {
      "title": "Actual"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "auto_fixable": {
      "default": false,
      "title": "Auto Fixable",
      "type": "boolean"
    },
    "requires_confirmation": {
      "default": false,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/IssueStatus",
      "default": "open"
    }
  },
  "required": [
    "id",
    "rule_id",
    "block_id",
    "severity",
    "expected",
    "actual",
    "message"
  ],
  "title": "DiagnosisIssue",
  "type": "object",
  "$id": "https://paperalign.local/schemas/diagnosis_issue.schema.json"
}
