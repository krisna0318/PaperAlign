{
  "$defs": {
    "UnsupportedObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "policy": {
          "enum": [
            "block_formatting",
            "manual_review",
            "report_only"
          ],
          "title": "Policy",
          "type": "string"
        },
        "part_name": {
          "title": "Part Name",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "relationship_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Type"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "external": {
          "default": false,
          "title": "External",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "policy",
        "part_name",
        "message"
      ],
      "title": "UnsupportedObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "safe_for_future_formatting": {
      "title": "Safe For Future Formatting",
      "type": "boolean"
    },
    "object_count": {
      "minimum": 0,
      "title": "Object Count",
      "type": "integer"
    },
    "error_count": {
      "minimum": 0,
      "title": "Error Count",
      "type": "integer"
    },
    "warning_count": {
      "minimum": 0,
      "title": "Warning Count",
      "type": "integer"
    },
    "info_count": {
      "minimum": 0,
      "title": "Info Count",
      "type": "integer"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/UnsupportedObject"
      },
      "title": "Objects",
      "type": "array"
    }
  },
  "required": [
    "safe_for_future_formatting",
    "object_count",
    "error_count",
    "warning_count",
    "info_count",
    "objects"
  ],
  "title": "UnsupportedObjectsReport",
  "type": "object",
  "$id": "https://paperalign.local/schemas/unsupported_objects.schema.json"
}
