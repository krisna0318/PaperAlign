{
  "$defs": {
    "BlockKind": {
      "enum": [
        "paragraph",
        "table",
        "table_cell",
        "image",
        "section_break",
        "page_break",
        "field",
        "unknown"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "DecisionSource": {
      "enum": [
        "word_style",
        "rule",
        "model",
        "hybrid",
        "user",
        "unknown"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "SemanticRole": {
      "enum": [
        "cover",
        "declaration",
        "abstract_zh",
        "abstract_en",
        "keywords_zh",
        "keywords_en",
        "table_of_contents",
        "heading_1",
        "heading_2",
        "heading_3",
        "body",
        "figure_caption",
        "table_caption",
        "reference_heading",
        "reference_entry",
        "appendix_heading",
        "appendix_body",
        "acknowledgement_heading",
        "acknowledgement_body",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "part_name": {
          "default": "word/document.xml",
          "title": "Part Name",
          "type": "string"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "table_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Index"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "cell_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Index"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceAnchor",
      "type": "object"
    },
    "StyleSnapshot": {
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Id"
        },
        "style_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Name"
        },
        "font_east_asia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font East Asia"
        },
        "font_latin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Latin"
        },
        "size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Pt"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Italic"
        },
        "alignment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment"
        },
        "line_spacing": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Spacing"
        },
        "space_before_pt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space Before Pt"
        },
        "space_after_pt": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space After Pt"
        },
        "first_line_indent_pt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Line Indent Pt"
        }
      },
      "title": "StyleSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A locatable and classifiable unit extracted from a DOCX package.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "order": {
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/BlockKind"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/SemanticRole",
      "default": "unknown"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "decision_source": {
      "$ref": "#/$defs/DecisionSource",
      "default": "unknown"
    },
    "requires_confirmation": {
      "default": false,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "style": {
      "$ref": "#/$defs/StyleSnapshot"
    },
    "source_anchor": {
      "$ref": "#/$defs/SourceAnchor"
    },
    "protected": {
      "default": true,
      "title": "Protected",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "id",
    "order",
    "kind",
    "source_anchor"
  ],
  "title": "DocumentBlock",
  "type": "object",
  "$id": "https://paperalign.local/schemas/document_block.schema.json"
}
