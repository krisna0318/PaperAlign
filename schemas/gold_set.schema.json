{
  "$defs": {
    "GoldAnnotation": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "source": {
          "enum": [
            "cloud_packet",
            "manual_only"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reason"
        },
        "status": {
          "default": "unassessed",
          "enum": [
            "unassessed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SemanticRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "block_id",
        "text_sha256",
        "source"
      ],
      "title": "GoldAnnotation",
      "type": "object"
    },
    "RuleScope": {
      "enum": [
        "document",
        "section",
        "cover_title",
        "cover_document_type",
        "cover_metadata",
        "declaration",
        "abstract_zh_heading",
        "abstract_zh_body",
        "abstract_en_title",
        "abstract_en_author",
        "abstract_en_affiliation",
        "abstract_en_body",
        "keywords_zh",
        "keywords_en",
        "toc_heading",
        "toc_entry",
        "heading_1",
        "heading_2",
        "heading_3",
        "heading_4",
        "body",
        "abbreviation_table",
        "table",
        "table_text",
        "table_caption",
        "table_note",
        "figure",
        "figure_caption",
        "figure_note",
        "equation",
        "footnote",
        "reference_heading",
        "reference_entry",
        "appendix_heading",
        "appendix_body",
        "acknowledgement_heading",
        "acknowledgement_body"
      ],
      "title": "RuleScope",
      "type": "string"
    },
    "SemanticRole": {
      "enum": [
        "cover",
        "declaration",
        "abstract_zh",
        "abstract_en",
        "keywords_zh",
        "keywords_en",
        "table_of_contents",
        "heading_1",
        "heading_2",
        "heading_3",
        "heading_4",
        "body",
        "list_item",
        "table",
        "table_text",
        "abbreviation_table",
        "abbreviation_heading",
        "figure",
        "equation",
        "figure_caption",
        "table_caption",
        "reference_heading",
        "reference_entry",
        "appendix_heading",
        "appendix_body",
        "acknowledgement_heading",
        "acknowledgement_body",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "content_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Fingerprint",
      "type": "string"
    },
    "source_plan_mode": {
      "enum": [
        "prompt_only",
        "hybrid"
      ],
      "title": "Source Plan Mode",
      "type": "string"
    },
    "target_count": {
      "minimum": 0,
      "title": "Target Count",
      "type": "integer"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/GoldAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    }
  },
  "required": [
    "input_sha256",
    "content_fingerprint",
    "source_plan_mode",
    "target_count",
    "annotations"
  ],
  "title": "GoldSet",
  "type": "object",
  "$id": "https://paperalign.local/schemas/gold_set.schema.json"
}
