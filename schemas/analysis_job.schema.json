{
  "$defs": {
    "AiMode": {
      "enum": [
        "off",
        "ambiguous_only",
        "full_baseline"
      ],
      "title": "AiMode",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "relative_path"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "created",
        "queued",
        "analyzing",
        "awaiting_confirmation",
        "formatting",
        "validating",
        "completed",
        "failed"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Metadata for one local processing job; manuscript text is stored elsewhere.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "created"
    },
    "ai_mode": {
      "$ref": "#/$defs/AiMode",
      "default": "off"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "input_filename": {
      "minLength": 1,
      "title": "Input Filename",
      "type": "string"
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    }
  },
  "required": [
    "id",
    "profile_id",
    "created_at",
    "updated_at",
    "input_filename"
  ],
  "title": "AnalysisJob",
  "type": "object",
  "$id": "https://paperalign.local/schemas/analysis_job.schema.json"
}
